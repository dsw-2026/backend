# Base de datos
DB_NAME=
DB_HOST=
DB_PORT=3306
DB_USER=
DB_PASSWORD=

# Firma de los tokens de sesión. Cadena larga y aleatoria, distinta en cada
JWT_SECRET=

# Origen del frontend habilitado para consultar esta API.
CORS_ORIGIN=http://localhost:5173

# Credenciales de la PRIMERA cuenta Admin, usadas solo por "pnpm seed:admin".
# No hay formulario público de alta de admins: la primera se carga por script.
ADMIN_USERNAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NOMBRE=Admin
ADMIN_APELLIDO=Fluffy